        <polygon x1="-9.1" y1="19" x2="9.1" y2="19" x3="0" y3="3" antialias="true"
                 style="line-style:normal;line-weight:normal;filling:none;color:black"/>
        <line x1="-8.1" y1="3" x2="8.1" y2="3" antialias="false"
